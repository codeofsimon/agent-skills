<?xml version='1.0' encoding='UTF-8'?>
{#- ============================================================
    ZUGFeRD 2.5 / Factur-X 1.09 — CII CrossIndustryInvoice
    Profil: EN16931 (urn:cen.eu:en16931:2017)
    Wird von scripts/generate_invoice.py gerendert.
    ACHTUNG: Die Element-Reihenfolge ist durch das XSD vorgegeben —
    Blöcke dürfen nicht umsortiert werden!
============================================================ -#}
<rsm:CrossIndustryInvoice xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100" xmlns:qdt="urn:un:unece:uncefact:data:standard:QualifiedDataType:100" xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100" xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">
  <rsm:ExchangedDocumentContext>
    <ram:GuidelineSpecifiedDocumentContextParameter>
      <ram:ID>{{ profile_urn }}</ram:ID>
    </ram:GuidelineSpecifiedDocumentContextParameter>
  </rsm:ExchangedDocumentContext>
  <rsm:ExchangedDocument>
    <ram:ID>{{ invoice_number }}</ram:ID>
    <ram:TypeCode>{{ type_code }}</ram:TypeCode>
    <ram:IssueDateTime>
      <udt:DateTimeString format="102">{{ issue_date }}</udt:DateTimeString>
    </ram:IssueDateTime>
{%- for note in notes %}
    <ram:IncludedNote>
      <ram:Content>{{ note.content }}</ram:Content>
{%- if note.subject_code %}
      <ram:SubjectCode>{{ note.subject_code }}</ram:SubjectCode>
{%- endif %}
    </ram:IncludedNote>
{%- endfor %}
  </rsm:ExchangedDocument>
  <rsm:SupplyChainTradeTransaction>
{%- for line in lines %}
    <ram:IncludedSupplyChainTradeLineItem>
      <ram:AssociatedDocumentLineDocument>
        <ram:LineID>{{ line.line_id }}</ram:LineID>
      </ram:AssociatedDocumentLineDocument>
      <ram:SpecifiedTradeProduct>
{%- if line.seller_assigned_id %}
        <ram:SellerAssignedID>{{ line.seller_assigned_id }}</ram:SellerAssignedID>
{%- endif %}
        <ram:Name>{{ line.name }}</ram:Name>
{%- if line.description %}
        <ram:Description>{{ line.description }}</ram:Description>
{%- endif %}
      </ram:SpecifiedTradeProduct>
      <ram:SpecifiedLineTradeAgreement>
        <ram:NetPriceProductTradePrice>
          <ram:ChargeAmount>{{ line.net_price }}</ram:ChargeAmount>
        </ram:NetPriceProductTradePrice>
      </ram:SpecifiedLineTradeAgreement>
      <ram:SpecifiedLineTradeDelivery>
        <ram:BilledQuantity unitCode="{{ line.unit_code }}">{{ line.quantity }}</ram:BilledQuantity>
      </ram:SpecifiedLineTradeDelivery>
      <ram:SpecifiedLineTradeSettlement>
        <ram:ApplicableTradeTax>
          <ram:TypeCode>VAT</ram:TypeCode>
          <ram:CategoryCode>{{ line.tax_category }}</ram:CategoryCode>
          <ram:RateApplicablePercent>{{ line.tax_rate }}</ram:RateApplicablePercent>
        </ram:ApplicableTradeTax>
        <ram:SpecifiedTradeSettlementLineMonetarySummation>
          <ram:LineTotalAmount>{{ line.line_total }}</ram:LineTotalAmount>
        </ram:SpecifiedTradeSettlementLineMonetarySummation>
      </ram:SpecifiedLineTradeSettlement>
    </ram:IncludedSupplyChainTradeLineItem>
{%- endfor %}
    <ram:ApplicableHeaderTradeAgreement>
{%- if buyer_reference %}
      <ram:BuyerReference>{{ buyer_reference }}</ram:BuyerReference>
{%- endif %}
      <ram:SellerTradeParty>
        <ram:Name>{{ seller.name }}</ram:Name>
{%- if seller.contact %}
        <ram:DefinedTradeContact>
{%- if seller.contact.name %}
          <ram:PersonName>{{ seller.contact.name }}</ram:PersonName>
{%- endif %}
{%- if seller.contact.phone %}
          <ram:TelephoneUniversalCommunication>
            <ram:CompleteNumber>{{ seller.contact.phone }}</ram:CompleteNumber>
          </ram:TelephoneUniversalCommunication>
{%- endif %}
{%- if seller.contact.email %}
          <ram:EmailURIUniversalCommunication>
            <ram:URIID>{{ seller.contact.email }}</ram:URIID>
          </ram:EmailURIUniversalCommunication>
{%- endif %}
        </ram:DefinedTradeContact>
{%- endif %}
        <ram:PostalTradeAddress>
          <ram:PostcodeCode>{{ seller.address.postcode }}</ram:PostcodeCode>
          <ram:LineOne>{{ seller.address.street }}</ram:LineOne>
          <ram:CityName>{{ seller.address.city }}</ram:CityName>
          <ram:CountryID>{{ seller.address.country }}</ram:CountryID>
        </ram:PostalTradeAddress>
{%- if seller.tax_number %}
        <ram:SpecifiedTaxRegistration>
          <ram:ID schemeID="FC">{{ seller.tax_number }}</ram:ID>
        </ram:SpecifiedTaxRegistration>
{%- endif %}
{%- if seller.vat_id %}
        <ram:SpecifiedTaxRegistration>
          <ram:ID schemeID="VA">{{ seller.vat_id }}</ram:ID>
        </ram:SpecifiedTaxRegistration>
{%- endif %}
      </ram:SellerTradeParty>
      <ram:BuyerTradeParty>
        <ram:Name>{{ buyer.name }}</ram:Name>
        <ram:PostalTradeAddress>
          <ram:PostcodeCode>{{ buyer.address.postcode }}</ram:PostcodeCode>
          <ram:LineOne>{{ buyer.address.street }}</ram:LineOne>
          <ram:CityName>{{ buyer.address.city }}</ram:CityName>
          <ram:CountryID>{{ buyer.address.country }}</ram:CountryID>
        </ram:PostalTradeAddress>
{%- if buyer.vat_id %}
        <ram:SpecifiedTaxRegistration>
          <ram:ID schemeID="VA">{{ buyer.vat_id }}</ram:ID>
        </ram:SpecifiedTaxRegistration>
{%- endif %}
      </ram:BuyerTradeParty>
{%- if order_reference %}
      <ram:BuyerOrderReferencedDocument>
        <ram:IssuerAssignedID>{{ order_reference }}</ram:IssuerAssignedID>
      </ram:BuyerOrderReferencedDocument>
{%- endif %}
    </ram:ApplicableHeaderTradeAgreement>
    <ram:ApplicableHeaderTradeDelivery>
{%- if delivery_date %}
      <ram:ActualDeliverySupplyChainEvent>
        <ram:OccurrenceDateTime>
          <udt:DateTimeString format="102">{{ delivery_date }}</udt:DateTimeString>
        </ram:OccurrenceDateTime>
      </ram:ActualDeliverySupplyChainEvent>
{%- endif %}
    </ram:ApplicableHeaderTradeDelivery>
    <ram:ApplicableHeaderTradeSettlement>
      <ram:InvoiceCurrencyCode>{{ currency }}</ram:InvoiceCurrencyCode>
{%- if payment.iban %}
      <ram:SpecifiedTradeSettlementPaymentMeans>
        <ram:TypeCode>{{ payment.means_code }}</ram:TypeCode>
        <ram:PayeePartyCreditorFinancialAccount>
          <ram:IBANID>{{ payment.iban }}</ram:IBANID>
{%- if payment.account_name %}
          <ram:AccountName>{{ payment.account_name }}</ram:AccountName>
{%- endif %}
        </ram:PayeePartyCreditorFinancialAccount>
{%- if payment.bic %}
        <ram:PayeeSpecifiedCreditorFinancialInstitution>
          <ram:BICID>{{ payment.bic }}</ram:BICID>
        </ram:PayeeSpecifiedCreditorFinancialInstitution>
{%- endif %}
      </ram:SpecifiedTradeSettlementPaymentMeans>
{%- endif %}
{%- for tax in tax_breakdown %}
      <ram:ApplicableTradeTax>
        <ram:CalculatedAmount>{{ tax.calculated }}</ram:CalculatedAmount>
        <ram:TypeCode>VAT</ram:TypeCode>
{%- if tax.exemption_reason %}
        <ram:ExemptionReason>{{ tax.exemption_reason }}</ram:ExemptionReason>
{%- endif %}
        <ram:BasisAmount>{{ tax.basis }}</ram:BasisAmount>
        <ram:CategoryCode>{{ tax.category }}</ram:CategoryCode>
        <ram:RateApplicablePercent>{{ tax.rate }}</ram:RateApplicablePercent>
      </ram:ApplicableTradeTax>
{%- endfor %}
      <ram:SpecifiedTradePaymentTerms>
{%- if payment.terms_description %}
        <ram:Description>{{ payment.terms_description }}</ram:Description>
{%- endif %}
{%- if payment.due_date %}
        <ram:DueDateDateTime>
          <udt:DateTimeString format="102">{{ payment.due_date }}</udt:DateTimeString>
        </ram:DueDateDateTime>
{%- endif %}
      </ram:SpecifiedTradePaymentTerms>
      <ram:SpecifiedTradeSettlementHeaderMonetarySummation>
        <ram:LineTotalAmount>{{ totals.line_total }}</ram:LineTotalAmount>
        <ram:ChargeTotalAmount>{{ totals.charge_total }}</ram:ChargeTotalAmount>
        <ram:AllowanceTotalAmount>{{ totals.allowance_total }}</ram:AllowanceTotalAmount>
        <ram:TaxBasisTotalAmount>{{ totals.tax_basis }}</ram:TaxBasisTotalAmount>
        <ram:TaxTotalAmount currencyID="{{ currency }}">{{ totals.tax_total }}</ram:TaxTotalAmount>
        <ram:GrandTotalAmount>{{ totals.grand_total }}</ram:GrandTotalAmount>
        <ram:TotalPrepaidAmount>{{ totals.prepaid }}</ram:TotalPrepaidAmount>
        <ram:DuePayableAmount>{{ totals.due_payable }}</ram:DuePayableAmount>
      </ram:SpecifiedTradeSettlementHeaderMonetarySummation>
{%- if referenced_invoice %}
      <ram:InvoiceReferencedDocument>
        <ram:IssuerAssignedID>{{ referenced_invoice.id }}</ram:IssuerAssignedID>
{%- if referenced_invoice.issue_date %}
        <ram:FormattedIssueDateTime>
          <qdt:DateTimeString format="102">{{ referenced_invoice.issue_date }}</qdt:DateTimeString>
        </ram:FormattedIssueDateTime>
{%- endif %}
      </ram:InvoiceReferencedDocument>
{%- endif %}
    </ram:ApplicableHeaderTradeSettlement>
  </rsm:SupplyChainTradeTransaction>
</rsm:CrossIndustryInvoice>
